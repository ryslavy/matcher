<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/settingsPanelStage"
        android:layout_width="768dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="24dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/launcher_settings"
                android:textColor="#FFFFFFFF"
                android:textSize="23sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.01" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="#22FFFFFF" />

            <ScrollView
                android:id="@+id/settingsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="1px"
                android:paddingBottom="1px"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="22dp"
                android:clipChildren="true"
                android:clipToPadding="true">

                <LinearLayout
                    android:id="@+id/settingsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/reorderChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/reorder"
                        android:visibility="gone" />

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:layout_marginTop="6dp"
                        android:text="@string/columns_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                        <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                        <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                        <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="7" />
                    </LinearLayout>

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:text="@string/rows_below_dock_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                        <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                        <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                        <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="3" />
                    </LinearLayout>

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:text="@string/dock_opacity_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                        <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                        <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                        <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="30%" />
                    </LinearLayout>

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:text="@string/dream_name" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
                        <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
                        <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:layout_marginEnd="0dp" android:text="@string/clock_format_24" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#1FFFFFFF" />

                    <TextView
                        android:id="@+id/wallpaperChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="14dp" />

                    <TextView
                        android:id="@+id/animationsChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/advancedChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/advanced_effects_warning"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/openOnStartChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="14dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/followThemeChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="14dp"
                        android:text="@string/follow_theme" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/follow_theme_hint"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12.5sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#1FFFFFFF" />

                    <TextView
                        android:id="@+id/defaultHomeChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="14dp"
                        android:text="@string/home_settings" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/home_settings_help"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvSettingsChoice"
                        style="@style/SettingsRow"
                        android:layout_marginTop="12dp"
                        android:text="@string/tv_settings" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
