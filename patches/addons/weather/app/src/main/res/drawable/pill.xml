<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent frosted glass pill for weather actions (living wobbly focus ring highlights focus). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#34FFFFFF"
                android:endColor="#1BFFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:endColor="#11FFFFFF" />
            <stroke android:width="1dp" android:color="#36FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
