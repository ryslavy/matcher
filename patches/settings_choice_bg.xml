<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4A34C759" android:endColor="#2834C759" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#1AFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3C34C759" android:endColor="#1E34C759" />
            <corners android:radius="14dp" />
            <stroke android:width="1.2dp" android:color="#B834C759" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1AFFFFFF" android:endColor="#0DFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</selector>
