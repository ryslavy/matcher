+        assertTrue(WallpaperMood.matchesDateKey("12-28..01-03", LocalDate.of(2026, 12, 30)));
+        assertTrue(WallpaperMood.matchesDateKey("12-28..01-03", LocalDate.of(2027, 1, 2)));
