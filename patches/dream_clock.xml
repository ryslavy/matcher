<?xml version="1.0" encoding="utf-8"?>
<!-- Ambient Screensaver (ClockActivity & ClockDream):
     Dimmed mood wallpaper + atmospheric blurred album-art wash + dynamic album-colored radial glow,
     paired with floating Clock/Weather/Solar/Status block and Frosted-Glass Now Playing card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF05060A"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Home's mood wallpaper, darkened by clock_wallpaper_dim with soft vignette. -->
    <ImageView
        android:id="@+id/dreamWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- 1B. Optional Apple TV 1080p slow-motion Aerial video layer (fades in smoothly once first frame decodes). -->
    <TextureView
        android:id="@+id/dreamVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Soft readability scrim over bright daytime Aerial videos (snow, clouds, ocean). -->
    <View
        android:id="@+id/dreamVideoScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- 2. Heavily blurred atmospheric wash of the active album cover when music is playing. -->
    <ImageView
        android:id="@+id/dreamArtWash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- 3. Soft dynamic radial ambient glow (album vivid color when playing, palette otherwise). -->
    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 4. Floating Clock + Date + Weather + Solar + Conditional Status Badges. -->
    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <view
                class="com.gathin.tvhome.LiquidClockView"
                android:id="@+id/dreamClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#F2FFFFFF"
                android:textSize="106sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#A6FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#A6FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.14"
            android:shadowColor="#58000000"
            android:shadowDy="0.9"
            android:shadowRadius="2.2"
            android:textAllCaps="true" />

        <!-- Weather (local) + next sunrise/sunset on one crisp editorial line. -->
        <LinearLayout
            android:id="@+id/dreamInfoRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/dreamWeatherGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/dreamWeatherIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="7dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/dreamWeatherText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF"
                    android:textSize="14.5sp"
                    android:fontFamily="@string/font_medium"
                    android:shadowColor="#58000000"
                    android:shadowDy="0.7"
                    android:shadowRadius="1.8"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/dreamInfoDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/dot_sep"
                android:textColor="#73FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dreamSolarGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/dreamSolarIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="5dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/dreamSolarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13.5sp"
                    android:fontFamily="@string/font_medium"
                    android:fontFeatureSettings="tnum"
                    android:shadowColor="#58000000"
                    android:shadowDy="0.7"
                    android:shadowRadius="1.8"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Conditional status chips (connected Bluetooth audio / active VPN). Hidden when none. -->
        <LinearLayout
            android:id="@+id/dreamBadgesRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/dreamAudioChip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="11dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_ambient_headphones"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/dreamAudioText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="220dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/dreamVpnChip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/ambient_vpn_badge"
                android:textColor="#D98DE6A8"
                android:textSize="11.5sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.06"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Frosted-Glass Now Playing Showcase Card (shown whenever music/media is active). -->
    <LinearLayout
        android:id="@+id/dreamMediaCard"
        android:layout_width="490dp"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_panel"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/dreamArtFrame"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginEnd="18dp">

            <ImageView
                android:id="@+id/dreamArtImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/dreamArtFallback"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/dreamArtRim"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Source app icon + name + live status dot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dreamMediaAppIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/dreamMediaAppName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#C4FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="@string/font_medium" />

                <View
                    android:id="@+id/dreamMediaStatusDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/dreamMediaStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11.5sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/dreamMediaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="19.5sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/dreamMediaSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#B8FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@string/font_regular" />

            <!-- Live progress bar + timestamps -->
            <LinearLayout
                android:id="@+id/dreamProgressBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/dreamProgressTrack"
                    android:layout_width="match_parent"
                    android:layout_height="4dp">

                    <View
                        android:id="@+id/dreamProgressFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dreamTimeElapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:singleLine="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/dreamTimeDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:singleLine="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@string/font_medium" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/dreamLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:singleLine="true"
                android:textColor="#FF6BE88E"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:visibility="gone" />

            <!-- Whisper-subtle remote legend; flashes bright with a crisp vector icon on media key feedback -->
            <LinearLayout
                android:id="@+id/dreamControlsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/dreamControlsIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/dreamControlsHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/ambient_controls_hint"
                    android:textColor="#78FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Whisper-subtle Apple TV Aerial location caption in the free bottom corner. -->
    <LinearLayout
        android:id="@+id/dreamAerialLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_cc_location"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/dreamAerialLocationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#CCFFFFFF"
            android:textSize="12.5sp"
            android:fontFamily="@string/font_medium" />
    </LinearLayout>
</FrameLayout>
