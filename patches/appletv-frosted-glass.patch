+            }
+            RecyclerView.ViewHolder vh = catalog.findViewHolderForAdapterPosition(target);
+            if (vh != null) {
+                if (!vh.itemView.hasFocus()) vh.itemView.requestFocus();
+                refreshReorderVisuals();
+                highlight(vh.itemView, movingPkg, true);
+            }
+        });
+    }
